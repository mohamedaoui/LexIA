# Configuration du déploiement Docker (docker compose). Copier en .env et remplir.
# Ne jamais versionner le fichier .env.

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Clé Gemini (gratuite) : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port d'accès à l'application : http://localhost:8080
LEXIA_PORT=8080

# Pour un serveur public : nom de domaine et HTTPS (derrière un proxy TLS).
# DJANGO_ALLOWED_HOSTS=lexia.example.ma
# DJANGO_CSRF_TRUSTED_ORIGINS=https://lexia.example.ma
# DJANGO_HTTPS=True
